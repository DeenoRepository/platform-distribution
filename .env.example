# Environment Configuration for 50-User Production Topology
NODE_ENV=production
PORT=3000

# Database Credentials
POSTGRES_USER=ems_admin
POSTGRES_PASSWORD=ems_secure_password
POSTGRES_DB=ems_platform
DATABASE_URL=postgresql://ems_admin:ems_secure_password@localhost:5432/ems_platform

# Redis Streams & Cache
REDIS_URL=redis://localhost:6379

# Security & Secrets
JWT_SECRET=super-secret-jwt-token-for-local-dev-only-min-32-chars
SESSION_SECRET=session-encryption-secret-key-32-chars-long
